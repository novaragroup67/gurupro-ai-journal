# =============================================================================
# GuruPro Environment Variables Template (AI-CORE-RECOVERY-1 Baseline)
# Copy this file to .env or .env.local and populate with your own values.
# NEVER commit .env or private credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Public Configuration (Frontend / Client)
# -----------------------------------------------------------------------------
# Canonical Project ID: dxzzpsrgbiummjplggyo
VITE_SUPABASE_PROJECT_ID="dxzzpsrgbiummjplggyo"
VITE_SUPABASE_URL="https://dxzzpsrgbiummjplggyo.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# -----------------------------------------------------------------------------
# 2. Supabase Server / Runtime Configuration (Server Functions / SSR)
# -----------------------------------------------------------------------------
SUPABASE_PROJECT_ID="dxzzpsrgbiummjplggyo"
SUPABASE_URL="https://dxzzpsrgbiummjplggyo.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"
# Service Role Key is strictly server-only. Used for administrative migration & batch jobs.
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# -----------------------------------------------------------------------------
# 3. Server-Authoritative AI Gateway / Provider Credentials (STRICTLY SERVER-ONLY)
# The client bundle NEVER receives these secrets. Provider calls fail closed if unset.
# -----------------------------------------------------------------------------
# Option 1: Google Gemini (Primary for AI Modul Ajar & Visual Generation)
GEMINI_API_KEY="your_gemini_api_key_here"

# Option 2: OpenAI Compatible (Fallback for Resilient Failover & Text Generation)
OPENAI_API_KEY="your_openai_api_key_here"

# Option 3: Lovable Gateway (Optional)
# LOVABLE_API_KEY="your_lovable_api_key_here"

# Optional Model & Endpoint Overrides
# AI_ENDPOINT="https://api.openai.com/v1/chat/completions"
# AI_MODEL="gemini-flash-lite-latest"
